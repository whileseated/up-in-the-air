# Copy to .env and edit. Only LAT and LON are required.

# The point to watch, in decimal degrees (south and west are negative).
# Example: the Eiffel Tower is LAT=48.8584, LON=2.2945.
LAT=
LON=

# Radius the page opens at, in nautical miles: one of 2, 5, 10, 25.
# Each browser can switch and remembers its own choice.
RADIUS_NM=5

# Radius asked of the position feed; the largest choice offered on the page.
MAX_RADIUS_NM=25

# Seconds between position-feed polls. Keep this at 60 or more: the feeds
# are free, shared services (adsb.lol allows 500 requests per IP per day).
REFRESH_S=300

# Timezone for the container's log timestamps.
TZ=UTC
